config {
  type: "view",
  schema: "l2_relationship",
  name: "rel_crm_erp_customer",
  assertions: {
    uniqueKey: ["crm_erp_customer_sk"]
  }
}

-- Grain: one row per matched CRM account / ERP customer pair, plus one row per unmatched account
-- and per unmatched customer. The only link between the systems is the ERP customer number typed
-- into the CRM account, so misses are kept and flagged (match_fl = false) instead of dropped:
-- data-quality reports list them for manual mapping.

with
l1_crm_account as (
  select *
  from ${ref({schema: 'l1_crm', name: 'account'})}
  -- 0 = active in the CRM; filtered here, not after the full outer join below
  where statecode = 0
)

, l2_masterdata_dim_customer as (
  select *
  from ${ref({schema: 'l2_masterdata', name: 'dim_customer'})}
  where customer_sk != ${keys.unknown()}
)

, matched as (
  select
    account.account_sk
    , dim_customer.customer_sk
  from l1_crm_account as account
  full outer join l2_masterdata_dim_customer as dim_customer
    on trim(account.erp_customer_number) = dim_customer.customer_num
)

, final as (
  select
    ${keys.composite("account_sk", "customer_sk")}            as crm_erp_customer_sk
    , coalesce(account_sk, ${keys.unknown()})                  as account_sk
    , coalesce(customer_sk, ${keys.unknown()})                 as customer_sk
    , case
      when account_sk is null then 'erp only'
      when customer_sk is null then 'crm only'
      else 'matched'
    end                                                       as match_status_cd
    , account_sk is not null and customer_sk is not null      as match_fl
    -- several CRM accounts carrying the same ERP number: a duplicate to clean up in the CRM
    , customer_sk is not null
    and count(account_sk) over (partition by customer_sk) > 1 as duplicate_match_fl
  from matched
)

select *
from final
