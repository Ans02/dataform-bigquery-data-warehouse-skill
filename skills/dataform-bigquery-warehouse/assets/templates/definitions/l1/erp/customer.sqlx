config {
  type: "table",
  schema: "l1_erp",
  name: "customer"
}

-- Source-aligned copy of the ERP customer table: casts and surrogate keys only, source names kept.
-- Materialized as a table because the raw table is external (Parquet on GCS).
-- Keys come from includes/keys.js, which holds the repository's key strategy.

select
  id
  , ${keys.surrogate("id")}             as customer_sk
  , cast(number as string)              as number
  , name
  , status
  , country_code
  , lower(email)                        as email
  , cast(entry_date as date)            as entry_date
  , cast(exit_date as date)             as exit_date
  , cast(last_update_time as timestamp) as last_update_time
from ${ref({schema: 'declaration_erp', name: 'customer_pq'})}
