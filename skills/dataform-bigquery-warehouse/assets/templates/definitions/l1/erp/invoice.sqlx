config {
  type: "table",
  schema: "l1_erp",
  name: "invoice"
}

-- Source-aligned copy of the ERP invoice table. The foreign key is keyed exactly like the
-- customer's surrogate key in l1_erp.customer, so L2 can join on customer_sk directly.

select
  id
  , ${keys.surrogate("id")}           as invoice_sk
  , ${keys.surrogate("customer_ref")} as customer_sk
  , document_number
  , cast(document_date as date)       as document_date
  , document_type
  , net_amount
  , vat_amount
  , gross_amount
  , open_amount
from ${ref({schema: 'declaration_erp', name: 'invoice_pq'})}
-- invoices before the ERP migration were re-keyed and can't be reconciled: history starts in 2020
where cast(document_date as date) >= date '2020-01-01'
